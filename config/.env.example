# MB Studio - Exemplo de Configurações de Ambiente (.env.example)
APP_ENV=local
APP_DEBUG=false

# Banco de Dados MySQL
DB_HOST=localhost
DB_NAME=tcc_agendamento
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Brevo API v3 (Envio de E-mails Transacionais via HTTPS / Porta 443)
BREVO_API_KEY=sua_chave_api_brevo_aqui
BREVO_FROM_EMAIL=seu_email_remetente@dominio.com
BREVO_FROM_NAME="Sistema de Agendamento"

