# Bloqueia acesso HTTP direto aos arquivos de configuração e variáveis de ambiente (.env)
<FilesMatch "^(\.env.*|config\.php|conexao\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

