# ============================================================================
# MB STUDIO — CONFIGURAÇÃO DE SEGURANÇA E ROTAS DO SERVIDOR WEB (APACHE)
# ============================================================================

# 1. Define o arquivo inicial padrão (Linux/Hostinger é case-sensitive) e desativa listagem de diretórios
DirectoryIndex Index.php index.php
Options -Indexes

# 2. Mapeamento Explícito de Rotas MVC (Primeiro Acesso, Perfil Admin e Diagnóstico)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rotas de Primeiro Acesso (Troca Obrigatória de Senha)
    RewriteRule ^primeiro-acesso/?$ View/PrimeiroAcesso.php [L,QSA]
    RewriteRule ^primeiro-acesso/salvar/?$ controller/PrimeiroAcessoController.php?action=salvar [L,QSA]

    # Rotas de Perfil Administrativo (Restrito a User_perm = 'A')
    RewriteRule ^admin/perfil/?$ View/admin/Perfil.php [L,QSA]
    RewriteRule ^admin/perfil/atualizar/?$ controller/PerfilController.php?action=atualizar [L,QSA]

    # Rota amigável de diagnóstico de e-mail (/teste-email)
    RewriteRule ^teste-email/?$ controller/TesteEmail.php [L,QSA]
</IfModule>

# 3. Cabeçalhos de Segurança HTTP (Mitigação de Clickjacking, MIME Sniffing e XSS)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Bloqueia acesso direto a arquivos de ambiente (.env), dumps SQL e logs
<FilesMatch "(^\.env|.*\.(sql|log|ini|sh|bak))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
