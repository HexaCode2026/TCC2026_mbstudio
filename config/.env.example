# MB Studio - Exemplo de Configurações de Ambiente (.env.example)
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
# Gere uma chave CSPRNG de 256 bits (64 caracteres hex) via: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=gere_uma_chave_hex_de_64_caracteres_com_random_bytes_32
PASSWORD_ALGO=bcrypt
PASSWORD_COST=11

# Banco de Dados MySQL
DB_HOST=localhost
DB_NAME=tcc_agendamento
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_TIMEOUT=5

# Configurações SMTP (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USER=seu_email@dominio.com
SMTP_PASS=sua_senha_de_app_smtp
SMTP_FROM_EMAIL=seu_email@dominio.com
SMTP_FROM_NAME="MB Studio"
SMTP_TIMEOUT=8
SMTP_DEBUG=0
SMTP_ASYNC_QUEUE=false
