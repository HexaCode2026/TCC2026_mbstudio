# ============================================================================
# MB STUDIO — CONFIGURAÇÃO DE SEGURANÇA DO SERVIDOR WEB (APACHE)
# ============================================================================

# 1. Desativa listagem de diretórios
Options -Indexes

# 2. Cabeçalhos de Segurança HTTP (Mitigação de Clickjacking, MIME Sniffing e XSS)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Bloqueia acesso direto a arquivos de ambiente (.env), dumps SQL e logs
<FilesMatch "(^\.env|.*\.(sql|log|ini|sh|bak))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

